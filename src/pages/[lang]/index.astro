---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/index/Hero.astro';
import About from '../../components/index/About.astro';
import Background from '../../components/index/Background.astro';
import Projects from '../../components/index/Projects.astro';
import BlogTeaser from '../../components/index/BlogTeaser.astro';
import Contact from '../../components/index/Contact.astro';
import { getStaticLangPaths, getTranslations, langs, type Lang } from '../../locales';
import { homeJsonLd } from '../../lib/seo';

export function getStaticPaths() {
    return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = getTranslations(lang);
const other = langs.find((l) => l !== lang) as Lang;
// Only the English home page is indexed; the Vietnamese one stays reachable for visitors.
const indexable = lang === 'en';
---

<BaseLayout
    lang={lang}
    title={t.meta.title}
    description={t.meta.description}
    indexable={indexable}
    jsonLd={indexable ? homeJsonLd() : []}
    alternateHref={`/${other}`}
>
    <div class="home relative isolate overflow-x-clip">
        <div class="hero-motif" aria-hidden="true"></div>
        <Hero lang={lang} />
        <About lang={lang} />
        <Background lang={lang} />
        <Projects lang={lang} />
        <BlogTeaser lang={lang} />
        <Contact lang={lang} />
    </div>
</BaseLayout>
