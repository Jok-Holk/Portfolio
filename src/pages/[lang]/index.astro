---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/index/Hero.astro';
import About from '../../components/index/About.astro';
import Background from '../../components/index/Background.astro';
import Projects from '../../components/index/Projects.astro';
import BlogTeaser from '../../components/index/BlogTeaser.astro';
import Contact from '../../components/index/Contact.astro';
import { getStaticLangPaths, getTranslations, langs, type Lang } from '../../locales';
import { getCollection } from 'astro:content';
import { homeJsonLd } from '../../lib/seo';
import motifSource from '../../assets/logo/motif.svg?raw';

export function getStaticPaths() {
    return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = getTranslations(lang);
const other = langs.find((l) => l !== lang) as Lang;
// Only the English home page is indexed; the Vietnamese one stays reachable for visitors.
const indexable = lang === 'en';
const projects = indexable ? await getCollection('projects', ({ data }) => data.lang === 'en') : [];
const motif = motifSource.replace('<svg ', '<svg preserveAspectRatio="xMaxYMid meet" width="100%" height="100%" ');
---

<BaseLayout
    lang={lang}
    title={t.meta.title}
    description={t.meta.description}
    indexable={indexable}
    jsonLd={indexable
        ? homeJsonLd(
              projects.map(({ data }) => ({
                  name: data.title,
                  codeUrl: data.codeLink,
                  demoUrl: data.demoLink,
                  tags: data.tags,
              })),
          )
        : []}
    alternateHref={`/${other}`}
>
    <div class="home relative isolate overflow-x-clip">
        <div class="hero-motif" aria-hidden="true" set:html={motif} />
        <Hero lang={lang} />
        <About lang={lang} />
        <Background lang={lang} />
        <Projects lang={lang} />
        <BlogTeaser lang={lang} />
        <Contact lang={lang} />
    </div>
</BaseLayout>
