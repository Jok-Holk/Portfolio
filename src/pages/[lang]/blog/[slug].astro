---
import type { InferGetStaticPropsType } from 'astro';
import { Picture } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BackLink from '../../../components/blog/BackLink.astro';
import { formatDate } from '../../../components/blog/utils';
import { getArticles, getStrapiUrl, type Article } from '../../../lib/strapi';
import { renderMarkdown } from '../../../lib/markdown';
import { clampText } from '../../../lib/seo';
import { getTranslations, langs, type Lang } from '../../../locales';
import '../../../styles/article.css';

/*
 * Theme variables read by article.css. Tailwind only emits variables it finds in use
 * and also scans plain text, so they are listed here:
 * --color-text --color-muted --color-subtle --color-line --color-line-strong --color-surface
 * --color-surface-2 --color-accent-soft --color-accent-deep --color-ok --color-bad
 * --font-mono --radius-sm --radius-md
 */

type Neighbour = { title: string; slug: string } | undefined;
type ArticlePath = {
    params: { lang: Lang; slug: string };
    props: { article: Article; previous: Neighbour; next: Neighbour };
};

export async function getStaticPaths() {
    const paths: ArticlePath[] = [];
    for (const lang of langs) {
        const articles = await getArticles(lang);
        articles.forEach((article, index) => {
            // Newest first, so the following index is the older post ("previous").
            const older = articles[index + 1];
            const newer = articles[index - 1];
            paths.push({
                params: { lang, slug: article.slug },
                props: {
                    article,
                    previous: older ? { title: older.title, slug: older.slug } : undefined,
                    next: newer ? { title: newer.title, slug: newer.slug } : undefined,
                },
            });
        });
    }
    return paths;
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const lang = Astro.params.lang as Lang;
const { article, previous, next } = Astro.props as Props;
const t = getTranslations(lang);
const otherLang = langs.find((l) => l !== lang) as Lang;

const { html, headings, readingTimeMinutes } = await renderMarkdown(article.content, {
    title: article.title,
    baseUrl: getStrapiUrl(),
});

const translation = article.localizations.find((l) => l.locale !== lang);
const alternateHref = translation ? `/${translation.locale}/blog/${translation.slug}` : `/${otherLang}/blog`;

const description = clampText(article.description || article.title, 160);
const cover = article.image;
const coverWidth = cover?.width && cover?.height ? Math.min(cover.width, 1200) : undefined;
const coverHeight = cover?.width && cover?.height && coverWidth ? Math.round((coverWidth * cover.height) / cover.width) : undefined;
const coverSizes = '(min-width: 768px) 700px, 100vw';
const coverClass = 'h-auto w-full rounded-md border border-line object-cover';
const coverWidths = coverWidth ? [600, 900, 1200].filter((w) => w <= coverWidth) : [];
if (coverWidth && !coverWidths.includes(coverWidth)) coverWidths.push(coverWidth);
---

<BaseLayout
    lang={lang}
    title={clampText(article.title, 60)}
    description={description}
    type="article"
    image={cover?.url}
    imageAlt={article.title}
    alternateHref={alternateHref}
>
    <article class="wrap py-10 sm:py-14">
        <div class="mx-auto max-w-[68ch]">
            <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
                <BackLink href={`/${lang}/blog`} label={t.blog.back} />
                {
                    translation && (
                        <a
                            href={alternateHref}
                            hreflang={translation.locale}
                            lang={translation.locale}
                            class="link font-mono text-sm"
                        >
                            {t.blog.otherLanguage}
                        </a>
                    )
                }
            </div>

            <header class="mt-8">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-subtle">
                    <span>
                        {t.blog.published}{' '}
                        <time datetime={article.publishDate} class="text-muted">{formatDate(article.publishDate, lang)}</time>
                    </span>
                    <span aria-hidden="true">/</span>
                    <span>{readingTimeMinutes} {t.blog.minRead}</span>
                </p>
                <h1 class="mt-3 text-balance text-3xl font-bold leading-tight text-text sm:text-4xl">{article.title}</h1>
                {article.description && <p class="mt-4 text-lg text-muted">{article.description}</p>}
                {
                    article.categories.length > 0 && (
                        <ul class="mt-5 flex flex-wrap gap-2" role="list">
                            {article.categories.map((category) => (
                                <li class="rounded-sm border border-line bg-surface-2 px-2 py-0.5 font-mono text-xs text-muted">
                                    {category.name}
                                </li>
                            ))}
                        </ul>
                    )
                }
            </header>

            {
                cover && (
                    <div class="mt-8">
                        {coverWidth && coverHeight ? (
                            <Picture
                                src={cover.url}
                                alt={cover.alt ?? ''}
                                width={coverWidth}
                                height={coverHeight}
                                widths={coverWidths}
                                sizes={coverSizes}
                                formats={['avif', 'webp']}
                                fallbackFormat="webp"
                                loading="eager"
                                decoding="sync"
                                fetchpriority="high"
                                class={coverClass}
                            />
                        ) : (
                            <Picture
                                src={cover.url}
                                alt={cover.alt ?? ''}
                                inferSize
                                formats={['avif', 'webp']}
                                fallbackFormat="webp"
                                loading="eager"
                                decoding="sync"
                                fetchpriority="high"
                                class={coverClass}
                            />
                        )}
                    </div>
                )
            }

            {
                headings.length >= 3 && (
                    <details class="mt-8 rounded-md border border-line bg-surface">
                        <summary class="cursor-pointer px-4 py-3 font-mono text-sm text-text">{t.blog.onThisPage}</summary>
                        <nav aria-label={t.blog.onThisPage} class="border-t border-line px-4 py-3">
                            <ol class="space-y-1.5 text-sm" role="list">
                                {headings.map((heading) => (
                                    <li class={heading.depth === 3 ? 'pl-4' : ''}>
                                        <a href={`#${heading.id}`} class="text-muted transition-colors hover:text-text">
                                            {heading.text}
                                        </a>
                                    </li>
                                ))}
                            </ol>
                        </nav>
                    </details>
                )
            }

            <div class="article mt-10" data-article data-copy-label={t.blog.copy} data-copied-label={t.blog.copied} set:html={html} />

            <hr class="mt-14 border-line" />

            {
                (previous || next) && (
                    <nav class="mt-8 grid gap-4 sm:grid-cols-2" aria-label={`${t.blog.previous} / ${t.blog.next}`}>
                        {previous && (
                            <a
                                href={`/${lang}/blog/${previous.slug}`}
                                rel="prev"
                                class="block rounded-md border border-line bg-surface p-4 transition-colors hover:border-line-strong"
                            >
                                <span class="block font-mono text-xs text-subtle">{t.blog.previous}</span>
                                <span class="mt-1 block font-bold leading-snug text-text">{previous.title}</span>
                            </a>
                        )}
                        {next && (
                            <a
                                href={`/${lang}/blog/${next.slug}`}
                                rel="next"
                                class="block rounded-md border border-line bg-surface p-4 transition-colors hover:border-line-strong sm:col-start-2 sm:text-right"
                            >
                                <span class="block font-mono text-xs text-subtle">{t.blog.next}</span>
                                <span class="mt-1 block font-bold leading-snug text-text">{next.title}</span>
                            </a>
                        )}
                    </nav>
                )
            }

            <div class="mt-10">
                <BackLink href={`/${lang}/blog`} label={t.blog.back} />
            </div>
        </div>
    </article>
</BaseLayout>

<script>
    // Adds a "Copy" button to every code block. Without JavaScript the blocks still read fine.
    const article = document.querySelector<HTMLElement>('[data-article]');

    if (article) {
        const copyLabel = article.dataset.copyLabel || 'Copy';
        const copiedLabel = article.dataset.copiedLabel || 'Copied';

        const copyText = async (text: string) => {
            if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(text);
                return;
            }
            // Fallback for older browsers and non-secure contexts.
            const area = document.createElement('textarea');
            area.value = text;
            area.setAttribute('readonly', '');
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.appendChild(area);
            area.select();
            const ok = document.execCommand('copy');
            area.remove();
            if (!ok) throw new Error('copy failed');
        };

        article.querySelectorAll<HTMLElement>('.code-block').forEach((block) => {
            const code = block.querySelector('pre code');
            const head = block.querySelector('.code-head');
            if (!code || !head) return;

            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'code-copy';
            button.textContent = copyLabel;

            // Screen readers do not reliably announce a button whose label changes, so a live region says it.
            const status = document.createElement('span');
            status.className = 'sr-only';
            status.setAttribute('role', 'status');
            status.setAttribute('aria-live', 'polite');

            let timer: number | undefined;
            button.addEventListener('click', async () => {
                try {
                    await copyText(code.textContent ?? '');
                } catch {
                    return;
                }
                button.textContent = copiedLabel;
                button.dataset.copied = 'true';
                status.textContent = copiedLabel;
                window.clearTimeout(timer);
                timer = window.setTimeout(() => {
                    button.textContent = copyLabel;
                    delete button.dataset.copied;
                    status.textContent = '';
                }, 2000);
            });

            head.append(button, status);
        });
    }
</script>
