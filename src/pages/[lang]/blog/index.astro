---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/blog/ArticleCard.astro';
import BackLink from '../../../components/blog/BackLink.astro';
import { searchKey } from '../../../components/blog/utils';
import { getArticles } from '../../../lib/strapi';
import { getStaticLangPaths, getTranslations, langs, type Lang } from '../../../locales';

export function getStaticPaths() {
    return getStaticLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = getTranslations(lang);
const other = langs.find((l) => l !== lang) as Lang;

// A failing request throws here and fails the build on purpose.
const articles = await getArticles(lang);

// One chip per tag, in alphabetical order.
const tags = new Map<string, string>();
for (const article of articles) {
    for (const category of article.categories) {
        const key = searchKey(category.name);
        if (key && !tags.has(key)) tags.set(key, category.name);
    }
}
const tagChips = [...tags.entries()].sort((a, b) => a[1].localeCompare(b[1], lang));

const chip =
    'rounded-sm border border-line bg-surface px-3 py-1.5 font-mono text-xs text-muted transition-colors hover:border-line-strong aria-pressed:border-neon aria-pressed:bg-neon aria-pressed:text-ink';
---

<BaseLayout lang={lang} title={t.blog.listTitle} description={t.blog.listDescription} alternateHref={`/${other}/blog`}>
    <div class="wrap py-12 sm:py-16" data-blog data-one={t.blog.resultsOne} data-many={t.blog.resultsMany}>
        <BackLink href={`/${lang}`} label={t.blog.backHome} />

        <header class="mt-8 max-w-2xl">
            <h1 class="text-3xl font-bold text-text sm:text-4xl">{t.blog.listTitle}</h1>
            <p class="mt-4 text-muted">{t.blog.listDescription}</p>
        </header>

        {
            articles.length === 0 ? (
                <p class="mt-12 rounded-md border border-line bg-surface p-6 text-muted">{t.blog.unavailable}</p>
            ) : (
                <>
                    {/* Search and tag filter need JavaScript, so they stay hidden without it. */}
                    <div class="mt-10 hidden [.js_&]:block" role="search">
                        <label for="blog-search" class="block font-mono text-xs text-subtle">
                            {t.blog.searchLabel}
                        </label>
                        <input
                            id="blog-search"
                            type="search"
                            data-search-input
                            autocomplete="off"
                            placeholder={t.blog.searchPlaceholder}
                            class="mt-2 w-full rounded-md border border-line bg-surface px-3 py-2.5 text-text placeholder:text-subtle"
                        />
                        {tagChips.length > 0 && (
                            <div class="mt-4 flex flex-wrap gap-2">
                                <button type="button" data-tag="" aria-pressed="true" class={chip}>
                                    {t.blog.allTags}
                                </button>
                                {tagChips.map(([key, name]) => (
                                    <button type="button" data-tag={key} aria-pressed="false" class={chip}>
                                        {name}
                                    </button>
                                ))}
                            </div>
                        )}
                    </div>

                    <p
                        class="mt-8 hidden font-mono text-xs text-subtle [.js_&]:block"
                        role="status"
                        aria-live="polite"
                        data-count
                    >
                        {articles.length} {articles.length === 1 ? t.blog.resultsOne : t.blog.resultsMany}
                    </p>

                    <ul class="mt-8 grid gap-4 [.js_&]:mt-3" role="list" data-list>
                        {articles.map((article, index) => (
                            <ArticleCard article={article} lang={lang} eager={index < 2} />
                        ))}
                    </ul>

                    <div class="mt-4 rounded-md border border-line bg-surface p-6" data-empty hidden>
                        <h2 class="text-lg font-bold text-text">{t.blog.emptyTitle}</h2>
                        <p class="mt-2 text-sm text-muted">{t.blog.emptyText}</p>
                        <button
                            type="button"
                            data-clear
                            class="mt-4 rounded-sm border border-line-strong bg-surface-2 px-3 py-1.5 font-mono text-xs text-text transition-colors hover:border-accent-soft"
                        >
                            {t.blog.clear}
                        </button>
                    </div>
                </>
            )
        }
    </div>
</BaseLayout>

<script>
    // Progressive enhancement: the full list is already in the HTML; this only hides what does not match.
    const root = document.querySelector<HTMLElement>('[data-blog]');
    const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
    const count = root?.querySelector<HTMLElement>('[data-count]');
    const empty = root?.querySelector<HTMLElement>('[data-empty]');
    const list = root?.querySelector<HTMLElement>('[data-list]');
    const clear = root?.querySelector<HTMLButtonElement>('[data-clear]');

    if (root && input && count && empty && list && clear) {
        const items = Array.from(list.querySelectorAll<HTMLElement>('[data-article]'));
        const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tag]'));
        const labelOne = root.dataset.one ?? '';
        const labelMany = root.dataset.many ?? '';
        let tag = '';

        // Same normalisation as searchKey() in components/blog/utils.ts: no diacritics, no case.
        const normalise = (text: string) =>
            text
                .normalize('NFD')
                .replace(/[̀-ͯ]/g, '')
                .replace(/đ/gi, 'd')
                .toLowerCase()
                .replace(/\s+/g, ' ')
                .trim();

        const apply = () => {
            const words = normalise(input.value).split(' ').filter(Boolean);
            let shown = 0;
            for (const item of items) {
                const tags = (item.dataset.tags ?? '').split('|');
                const haystack = item.dataset.search ?? '';
                const visible = (!tag || tags.includes(tag)) && words.every((word) => haystack.includes(word));
                item.hidden = !visible;
                if (visible) shown++;
            }
            for (const chip of chips) chip.setAttribute('aria-pressed', String((chip.dataset.tag ?? '') === tag));
            count.textContent = `${shown} ${shown === 1 ? labelOne : labelMany}`;
            empty.hidden = shown !== 0;
            list.hidden = shown === 0;
        };

        input.addEventListener('input', apply);
        for (const chip of chips) {
            chip.addEventListener('click', () => {
                const key = chip.dataset.tag ?? '';
                tag = key === tag ? '' : key;
                apply();
            });
        }
        clear.addEventListener('click', () => {
            input.value = '';
            tag = '';
            apply();
            input.focus();
        });
        // The browser may restore the typed text when coming back to the page.
        if (input.value) apply();
    }
</script>
