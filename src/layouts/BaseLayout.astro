---
import '../styles/tailwind.css';
import Head from '../components/seo/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getTranslations, type Lang } from '../locales';

interface Props {
    lang: Lang;
    title: string;
    description: string;
    indexable?: boolean;
    image?: string;
    imageAlt?: string;
    type?: 'website' | 'article';
    jsonLd?: object[];
    /** URL of the same page in the other language, if one exists. */
    alternateHref?: string;
}

const { lang, title, description, indexable, image, imageAlt, type, jsonLd, alternateHref } = Astro.props;
const t = getTranslations(lang);
---

<!doctype html>
<html lang={lang}>
    <head>
        <Head
            title={title}
            description={description}
            lang={lang}
            path={Astro.url.pathname}
            indexable={indexable}
            image={image}
            imageAlt={imageAlt}
            type={type}
            jsonLd={jsonLd}
        />
    </head>
    <body class="min-h-screen flex flex-col">
        <a
            href="#main"
            class="sr-only-focusable fixed left-4 top-4 z-50 rounded-sm bg-text px-3 py-2 text-ink"
        >
            {t.nav.skip}
        </a>
        <Header lang={lang} alternateHref={alternateHref} />
        <main id="main" class="flex-1">
            <slot />
        </main>
        <Footer lang={lang} />
        <script>
            // Reveal-on-scroll: elements marked data-reveal fade in once. Content stays visible without JS.
            const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
            if ('IntersectionObserver' in window && targets.length) {
                const io = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                io.unobserve(entry.target);
                            }
                        }
                    },
                    { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
                );
                targets.forEach((el) => io.observe(el));
                // Safety net: never leave content hidden (slow devices, screenshot/print tools, crawlers).
                window.setTimeout(() => targets.forEach((el) => el.classList.add('is-visible')), 2500);
                window.addEventListener('beforeprint', () => targets.forEach((el) => el.classList.add('is-visible')));
            } else {
                targets.forEach((el) => el.classList.add('is-visible'));
            }
        </script>
    </body>
</html>
