---
import Mascot from '../Mascot.astro';
import { getTranslations, type Lang } from '../../locales';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="about" class="wrap py-14 sm:py-20" aria-labelledby="about-title">
    <h2 id="about-title" class="section-title font-bold text-text">{t.about.title}</h2>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_auto] lg:gap-14" data-reveal>
        <div>
            <div class="max-w-[68ch] space-y-5 text-muted">
                {t.about.body.map((paragraph) => <p>{paragraph}</p>)}
            </div>

            <dl class="mt-10 grid max-w-[68ch] gap-x-8 gap-y-5 border-t border-line pt-8 sm:grid-cols-[8rem_1fr]">
                {
                    t.about.facts.map((fact) => (
                        <>
                            <dt class="font-mono text-sm text-subtle">{fact.label}</dt>
                            <dd class="text-text">{fact.value}</dd>
                        </>
                    ))
                }
            </dl>
        </div>

        <div class="flex justify-center lg:items-start lg:pt-6">
            <Mascot lang={lang} size="md" />
        </div>
    </div>
</section>
