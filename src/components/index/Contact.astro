---
import { getTranslations, type Lang } from '../../locales';
import { WORK_EMAIL } from '../../lib/site';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// Copy that is not in the shared locale files yet (field length errors, no-JS note).
const extra = {
    en: {
        errorShort: 'Please write at least 10 characters.',
        errorLong: 'This is too long. Please shorten it.',
        noscript: 'This form needs JavaScript. Please email me directly:',
    },
    vi: {
        errorShort: 'Vui lòng nhập ít nhất 10 ký tự.',
        errorLong: 'Nội dung quá dài, vui lòng rút gọn.',
        noscript: 'Biểu mẫu này cần bật JavaScript. Vui lòng gửi email trực tiếp:',
    },
}[lang === 'vi' ? 'vi' : 'en'];

const mailto = `mailto:${WORK_EMAIL}`;

const inputClass =
    'block w-full bg-surface border border-line rounded-md px-4 py-3 text-text placeholder:text-subtle focus:border-accent-soft aria-[invalid=true]:border-bad';
const labelClass = 'block font-mono text-sm text-muted mb-2';
const errorClass = 'mt-2 text-sm text-bad';
---

<section id="contact" aria-labelledby="contact-title" class="wrap py-16 sm:py-24">
    <h2 id="contact-title" class="section-title font-bold text-text">{t.contact.title}</h2>
    <p class="mt-3 max-w-[40rem] text-muted">{t.contact.intro}</p>
    <p class="mt-2"><a class="link font-mono" href={mailto}>{WORK_EMAIL}</a></p>

    <div id="contact-root" class="mt-8 max-w-[40rem]">
        <form
            id="contact-form"
            novalidate
            hidden
            class="grid gap-6"
            data-err-required={t.contact.errorRequired}
            data-err-email={t.contact.errorEmail}
            data-err-short={extra.errorShort}
            data-err-long={extra.errorLong}
            data-err-generic={t.contact.errorGeneric}
            data-label-send={t.contact.send}
            data-label-sending={t.contact.sending}
        >
            <div>
                <label for="contact-name" class={labelClass}>{t.contact.name}</label>
                <input
                    id="contact-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    maxlength="100"
                    required
                    aria-describedby="contact-name-error"
                    placeholder={t.contact.namePlaceholder}
                    class={inputClass}
                />
                <p id="contact-name-error" class={errorClass} hidden></p>
            </div>

            <div>
                <label for="contact-email" class={labelClass}>{t.contact.email}</label>
                <input
                    id="contact-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    maxlength="254"
                    required
                    aria-describedby="contact-email-error"
                    placeholder={t.contact.emailPlaceholder}
                    class={inputClass}
                />
                <p id="contact-email-error" class={errorClass} hidden></p>
            </div>

            <div>
                <label for="contact-message" class={labelClass}>{t.contact.message}</label>
                <textarea
                    id="contact-message"
                    name="message"
                    rows="6"
                    maxlength="5000"
                    required
                    aria-describedby="contact-message-error"
                    placeholder={t.contact.messagePlaceholder}
                    class={`${inputClass} min-h-40 resize-y`}></textarea>
                <p id="contact-message-error" class={errorClass} hidden></p>
            </div>

            <div class="hp-field" aria-hidden="true">
                <label for="contact-hp">{t.contact.honeypotLabel}</label>
                <input id="contact-hp" name="_gotcha" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
            </div>

            <div id="contact-error" hidden class="border border-bad rounded-md px-4 py-3 text-bad"></div>

            <div>
                <button
                    id="contact-submit"
                    type="submit"
                    class="btn-neon px-6 py-3"
                >
                    <span data-label>{t.contact.send}</span>
                </button>
            </div>
        </form>

        <div aria-live="polite">
            <div id="contact-success" hidden class="border border-line-strong bg-surface rounded-md p-6">
                <h3 id="contact-success-title" tabindex="-1" class="font-mono text-xl text-text">
                    {t.contact.successTitle}
                </h3>
                <p class="mt-3 text-muted">{t.contact.successText}</p>
                <button
                    id="contact-again"
                    type="button"
                    class="mt-5 border border-line-strong rounded-md px-5 py-2 font-mono text-text hover:border-accent-soft"
                >
                    {t.contact.sendAnother}
                </button>
            </div>
        </div>

        <noscript>
            <p class="text-muted">
                {extra.noscript}
                <a class="link font-mono" href={mailto}>{WORK_EMAIL}</a>
            </p>
        </noscript>
    </div>
</section>

<script>
    type FieldKey = 'name' | 'email' | 'message';
    type TokenState = { t: number; sig: string; got: number } | null;

    const KEYS: FieldKey[] = ['name', 'email', 'message'];
    // The server drops anything faster than 3 s after the token was issued, so a very
    // quick (autofilled) submit waits a moment instead of being silently discarded.
    const MIN_TOKEN_AGE_MS = 3500;
    // Tokens expire after 2 h on the server; refresh well before that.
    const STALE_TOKEN_MS = 90 * 60 * 1000;

    function sleep(ms: number): Promise<void> {
        return new Promise((resolve) => setTimeout(resolve, ms));
    }

    function init(): void {
        const root = document.getElementById('contact-root');
        const form = document.getElementById('contact-form') as HTMLFormElement | null;
        const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
        const label = submit ? submit.querySelector('[data-label]') : null;
        const generic = document.getElementById('contact-error');
        const success = document.getElementById('contact-success');
        const successTitle = document.getElementById('contact-success-title');
        const again = document.getElementById('contact-again');
        const honeypot = document.getElementById('contact-hp') as HTMLInputElement | null;
        if (!root || !form || !submit || !label || !generic || !success || !successTitle || !again || !honeypot) return;

        const inputs = {} as Record<FieldKey, HTMLInputElement | HTMLTextAreaElement>;
        const errors = {} as Record<FieldKey, HTMLElement>;
        for (const key of KEYS) {
            const input = document.getElementById('contact-' + key) as HTMLInputElement | HTMLTextAreaElement | null;
            const error = document.getElementById('contact-' + key + '-error');
            if (!input || !error) return;
            inputs[key] = input;
            errors[key] = error;
        }

        const text = form.dataset;
        const messageFor = (code: string): string => {
            if (code === 'email') return text.errEmail || '';
            if (code === 'too_short') return text.errShort || '';
            if (code === 'too_long') return text.errLong || '';
            return text.errRequired || '';
        };

        let token: TokenState = null;
        async function fetchToken(): Promise<TokenState> {
            try {
                const res = await fetch('/api/contact', { method: 'GET', cache: 'no-store', headers: { Accept: 'application/json' } });
                if (!res.ok) return null;
                const data = await res.json();
                if (data && typeof data.t === 'number' && typeof data.sig === 'string') {
                    return { t: data.t, sig: data.sig, got: performance.now() };
                }
            } catch {
                // The server decides what to do with a missing token.
            }
            return null;
        }
        let pending: Promise<void> | null = fetchToken().then((next) => {
            token = next;
            pending = null;
        });

        async function getToken(): Promise<TokenState> {
            if (pending) await pending;
            if (!token || performance.now() - token.got > STALE_TOKEN_MS) token = await fetchToken();
            if (token) {
                const wait = MIN_TOKEN_AGE_MS - (performance.now() - token.got);
                if (wait > 0) await sleep(wait);
            }
            return token;
        }

        function setError(key: FieldKey, code: string | null): void {
            const el = errors[key];
            const input = inputs[key];
            if (code) {
                el.setAttribute('role', 'alert');
                el.textContent = messageFor(code);
                el.hidden = false;
                input.setAttribute('aria-invalid', 'true');
            } else {
                el.hidden = true;
                el.textContent = '';
                el.removeAttribute('role');
                input.removeAttribute('aria-invalid');
            }
        }

        function validate(key: FieldKey): string | null {
            const value = inputs[key].value.trim();
            if (value === '') return 'required';
            if (key === 'name' && value.length > 100) return 'too_long';
            if (key === 'email') {
                if (value.length > 254) return 'too_long';
                if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) return 'email';
            }
            if (key === 'message') {
                if (value.length < 10) return 'too_short';
                if (value.length > 5000) return 'too_long';
            }
            return null;
        }

        function showGeneric(): void {
            generic!.setAttribute('role', 'alert');
            generic!.textContent = text.errGeneric || '';
            generic!.hidden = false;
        }
        function hideGeneric(): void {
            generic!.hidden = true;
            generic!.textContent = '';
            generic!.removeAttribute('role');
        }

        for (const key of KEYS) {
            inputs[key].addEventListener('input', () => {
                if (!errors[key].hidden) setError(key, null);
            });
        }

        let sending = false;
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (sending) return;
            hideGeneric();

            let firstInvalid: FieldKey | null = null;
            for (const key of KEYS) {
                const code = validate(key);
                setError(key, code);
                if (code && !firstInvalid) firstInvalid = key;
            }
            if (firstInvalid) {
                inputs[firstInvalid].focus();
                return;
            }

            sending = true;
            submit.disabled = true;
            label.textContent = text.labelSending || '';
            form.setAttribute('aria-busy', 'true');

            let outcome: 'success' | 'field' | 'generic' = 'generic';
            let badField: FieldKey | null = null;
            try {
                const tk = await getToken();
                const res = await fetch('/api/contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: inputs.name.value.trim(),
                        email: inputs.email.value.trim(),
                        message: inputs.message.value.trim(),
                        _gotcha: honeypot.value,
                        t: tk ? tk.t : undefined,
                        sig: tk ? tk.sig : undefined,
                    }),
                });
                let data: { ok?: boolean; field?: string; error?: string } | null = null;
                try {
                    data = await res.json();
                } catch {
                    data = null;
                }
                if (res.ok && data && data.ok === true) {
                    outcome = 'success';
                } else if (res.status === 422 && data && data.field && (KEYS as string[]).indexOf(data.field) !== -1) {
                    badField = data.field as FieldKey;
                    setError(badField, data.error || 'required');
                    outcome = 'field';
                }
            } catch {
                outcome = 'generic';
            }

            sending = false;
            submit.disabled = false;
            label.textContent = text.labelSend || '';
            form.removeAttribute('aria-busy');

            if (outcome === 'success') {
                form.reset();
                form.hidden = true;
                success.hidden = false;
                successTitle.focus();
            } else if (outcome === 'field' && badField) {
                inputs[badField].focus();
            } else {
                showGeneric();
                submit.focus();
            }
        });

        again.addEventListener('click', () => {
            success.hidden = true;
            form.hidden = false;
            inputs.name.focus();
        });

        form.hidden = false;
    }

    init();
</script>

<style>
    /* Honeypot: off-screen (not display:none, which many bots skip) and out of the tab order. */
    .hp-field {
        position: absolute;
        left: -10000px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }
</style>
