---
import { getCollection, render } from 'astro:content';
import { getTranslations, type Lang } from '../../locales';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const experience = await getCollection('experience', ({ data }) => data.lang === lang);
const experienceItems = await Promise.all(
    experience.map(async (entry) => ({ data: entry.data, Content: (await render(entry)).Content })),
);
---

<section id="background" class="wrap py-14 sm:py-20" aria-labelledby="background-title">
    <h2 id="background-title" class="section-title font-bold text-text">{t.background.title}</h2>

    <div class="mt-8 grid gap-12 lg:grid-cols-2" data-reveal>
        <div>
            <h3 class="font-mono text-sm uppercase tracking-wide text-subtle">{t.background.education}</h3>
            <ul class="mt-4 divide-y divide-line border-y border-line">
                {
                    t.background.educationItems.map((item) => (
                        <li class="py-5">
                            <p class="font-mono text-sm text-subtle">{item.dates}</p>
                            <h4 class="mt-1 text-lg font-bold text-text">
                                <a class="link" href={item.url} target="_blank" rel="noopener noreferrer">
                                    {item.institution}
                                </a>
                            </h4>
                            <p class="mt-1 text-muted">{item.program}</p>
                            <p class="mt-1 text-sm text-subtle">{item.details}</p>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div>
            <h3 class="font-mono text-sm uppercase tracking-wide text-subtle">{t.background.experience}</h3>
            <ul class="mt-4 divide-y divide-line border-y border-line">
                {
                    experienceItems.map(({ data, Content }) => (
                        <li class="py-5">
                            <p class="font-mono text-sm text-subtle">{data.time}</p>
                            <h4 class="mt-1 text-lg font-bold text-text">
                                <a class="link" href={data.url} target="_blank" rel="noopener noreferrer">
                                    {data.title}
                                </a>
                                <span class="font-normal text-muted"> · {data.company}</span>
                            </h4>
                            <div class="mt-2 space-y-3 text-muted">
                                <Content />
                            </div>
                            <ul class="mt-3 flex flex-wrap gap-2">
                                {data.techs.map((tech) => (
                                    <li class="rounded-sm border border-line px-2 py-1 font-mono text-xs text-muted">{tech}</li>
                                ))}
                            </ul>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>
