---
import { getCollection, render } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { getTranslations, type Lang } from '../../locales';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const projects = await getCollection('projects', ({ data }) => data.lang === lang);
const items = await Promise.all(
    projects.map(async (entry) => ({ data: entry.data, Content: (await render(entry)).Content })),
);
---

<section id="projects" class="wrap py-14 sm:py-20" aria-labelledby="projects-title">
    <h2 id="projects-title" class="section-title font-bold text-text">{t.projects.title}</h2>

    <div class="mt-8 grid gap-6 sm:grid-cols-2" data-reveal>
        {
            items.map(({ data, Content }) => (
                <ProjectCard
                    title={data.title}
                    tags={data.tags}
                    codeLink={data.codeLink}
                    demoLink={data.demoLink}
                    codeLabel={t.projects.code}
                    demoLabel={t.projects.demo}
                    role={data.role}
                    image={data.image}
                    imageAlt={data.imageAlt}
                >
                    <Content />
                </ProjectCard>
            ))
        }
    </div>
</section>
