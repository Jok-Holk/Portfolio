---
import { getTranslations, type Lang } from '../locales';
import { LINKS, WORK_EMAIL, cvUrl } from '../lib/site';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-accent-deep">
    <div
        class="wrap flex flex-col items-start justify-between gap-3 py-8 font-mono text-sm text-subtle sm:flex-row sm:items-center"
    >
        <p>© {year} {t.footer.copyright}</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
            <li><a class="link" href={`mailto:${WORK_EMAIL}`}>{t.footer.email}</a></li>
            <li><a class="link" href={LINKS.github} rel="noopener noreferrer" target="_blank">{t.footer.github}</a></li>
            <li><a class="link" href={cvUrl(lang)} rel="noopener noreferrer" target="_blank">{t.footer.cv}</a></li>
        </ul>
    </div>
</footer>
