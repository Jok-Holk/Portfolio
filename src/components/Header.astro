---
import { getTranslations, supportedLocales, langs, type Lang } from '../locales';
import { SITE_NAME } from '../lib/site';

interface Props {
    lang: Lang;
    alternateHref?: string;
}

const { lang, alternateHref } = Astro.props;
const t = getTranslations(lang);

const home = `/${lang}`;
const nav = [
    { id: 'about', label: t.nav.about },
    { id: 'background', label: t.nav.background },
    { id: 'projects', label: t.nav.projects },
    { id: 'blogs', label: t.nav.blog },
    { id: 'contact', label: t.nav.contact },
];

const other = langs.find((l) => l !== lang) as Lang;
const switchHref = alternateHref ?? `/${other}`;
---

<header class="header-glow sticky top-0 z-40 bg-ink">
    <div class="wrap flex h-16 items-center justify-between gap-4">
        <a href={home} class="flex items-center gap-3 font-mono font-bold text-text" aria-label={`${SITE_NAME}: ${t.nav.home}`}>
            <img src="/logo-mark.svg" alt="" width="32" height="32" class="h-8 w-8" />
            <span>{SITE_NAME}</span>
        </a>

        <nav aria-label="Primary" class="hidden items-center gap-6 md:flex">
            {
                nav.map((item) => (
                    <a
                        href={`${home}#${item.id}`}
                        data-nav={item.id}
                        class="font-mono text-sm text-muted transition-colors hover:text-text aria-[current=true]:text-neon"
                    >
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <div class="flex items-center gap-4">
            <div class="flex items-center gap-1 font-mono text-sm" aria-label={t.nav.language}>
                {
                    langs.map((l, i) => (
                        <>
                            {i > 0 && <span class="text-line-strong">|</span>}
                            {l === lang ? (
                                <span aria-current="true" class="text-neon">
                                    {supportedLocales[l].short}
                                </span>
                            ) : (
                                <a
                                    href={switchHref}
                                    hreflang={l}
                                    lang={l}
                                    class="text-muted transition-colors hover:text-text"
                                    aria-label={`${supportedLocales[l].short} (${supportedLocales[l].name})`}
                                >
                                    {supportedLocales[l].short}
                                </a>
                            )}
                        </>
                    ))
                }
            </div>

            <button
                type="button"
                id="menu-toggle"
                class="rounded-sm border border-line px-3 py-1.5 font-mono text-sm text-text md:hidden"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                {t.nav.menu}
            </button>
        </div>
    </div>

    <nav id="mobile-menu" aria-label="Primary" class="hidden border-t border-line md:hidden">
        <ul class="wrap flex flex-col py-2">
            {
                nav.map((item) => (
                    <li>
                        <a
                            href={`${home}#${item.id}`}
                            data-nav={item.id}
                            class="block py-3 font-mono text-text aria-[current=true]:text-neon"
                        >
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<script>
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
        const setOpen = (open: boolean) => {
            toggle.setAttribute('aria-expanded', String(open));
            menu.classList.toggle('hidden', !open);
        };
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        menu.addEventListener('click', (e) => {
            if ((e.target as HTMLElement).closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') setOpen(false);
        });
    }

    // Mark the nav link of the section currently in view (home page only).
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
    const sections = [...links]
        .map((a) => document.getElementById(a.dataset.nav as string))
        .filter((el): el is HTMLElement => !!el);
    if (sections.length && 'IntersectionObserver' in window) {
        const spy = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    links.forEach((a) =>
                        a.setAttribute('aria-current', String(a.dataset.nav === (entry.target as HTMLElement).id)),
                    );
                }
            },
            { rootMargin: '-40% 0px -55% 0px' },
        );
        sections.forEach((s) => spy.observe(s));
    }
</script>
