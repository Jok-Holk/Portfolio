# Copy to .env.local for local overrides. Real secrets go in Vercel's environment settings.

# Strapi base URL (also set in the tracked .env).
STRAPI_URL=https://strapi.jokholk.dev

# Contact form (server only, set these in Vercel):
# HMAC secret for the form's time token. Generate one: openssl rand -hex 32
CONTACT_SECRET=
# Formspree form id; falls back to the site's default id when empty.
FORMSPREE_FORM_ID=

# Local preview only: show the draft copy from src/locales/*.draft.json.
# CONTENT_DRAFT=1
